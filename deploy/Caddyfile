{$SITE_ADDRESS} {
    encode zstd gzip
    basic_auth {
        {$SITE_USER} {$SITE_PASSWORD_HASH}
    }
    handle /api/* {
        reverse_proxy api:3001 {
            header_up -Authorization
        }
    }
    handle /_AMapService/* {
        reverse_proxy api:3001 {
            header_up -Authorization
        }
    }
    handle /history {
        reverse_proxy chat:8080 {
            header_up -Authorization
        }
    }
    handle /ws {
        # Browser credentials alone do not prevent cross-site WebSocket requests.
        # CLI clients without Origin are allowed; browsers must use this origin.
        @crossOrigin expression header({'Origin': '*'}) && {http.request.header.Origin} != {http.request.scheme} + '://' + {http.request.hostport}
        respond @crossOrigin "WebSocket origin not allowed" 403
        reverse_proxy chat:8080 {
            header_up -Authorization
        }
    }
    handle {
        root * /srv
        try_files {path} /index.html
        file_server
    }
}
