{$SITE_ADDRESS} {
    encode zstd gzip
    basic_auth {
        {$SITE_USER} {$SITE_PASSWORD_HASH}
    }
    handle /api/* {
        reverse_proxy api:3001 {
            flush_interval -1
            header_up -Authorization
        }
    }
    handle /_AMapService/* {
        reverse_proxy api:3001 {
            header_up -Authorization
        }
    }
    handle /ws {
        reverse_proxy chat:8080 {
            header_up -Authorization
        }
    }
    handle {
        root * /srv
        try_files {path} /index.html
        file_server
    }
}
