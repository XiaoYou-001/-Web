# 复制此文件为 .env。服务端变量不能使用 VITE_ 前缀。

# Node AI 服务（启动时读取项目根目录的 .env，系统环境变量优先）
PORT=
GLAI2_API_KEY=
AI_API_ENDPOINT=
AI_REQUEST_TIMEOUT_MS=

# 公开的前端接口配置；默认 /api 由开发服务器转发至 Node 服务
VITE_API_BASE_URL=
VITE_API_REQUEST_TIMEOUT_MS=
# 应大于服务端 AI_REQUEST_TIMEOUT_MS，为代理及响应传输留出时间
VITE_AI_REQUEST_TIMEOUT_MS=
# 仅在接入真实线路后端后填写；当前线路仍按账号保存在浏览器
VITE_ROUTES_API_BASE_URL=

# 可选的公开 WebSocket 地址；留空使用当前站点的 /ws（HTTPS 自动使用 wss）
VITE_CHAT_WS_URL=
# 可选：聊天历史 HTTP 地址；留空由 WebSocket 地址推导（/ws → /history），默认走同源代理
VITE_CHAT_HTTP_URL=

# 高德 Web 端公开 Key；留空时显示地图未配置，不请求 SDK
VITE_AMAP_KEY=
# 可选的安全代理地址，以 /_AMapService 结尾；安全密钥只放在代理服务端
VITE_AMAP_SERVICE_HOST=
# 服务端安全密钥，不得加 VITE_ 前缀
AMAP_SECURITY_JS_CODE=
# 可选：同源加载 SDK；留空直接从高德加载
VITE_AMAP_SDK_PROXY=
# 仅未来直接调用 Web Service 时需要；当前 JS API 查询可留空
AMAP_WEB_SERVICE_KEY=

# 短信目前仍为演示实现。真实密钥只能配置在未来的服务端短信接口中。
# 以下为可公开的前端展示配置。
VITE_SMS_SIGN_NAME=
VITE_SMS_TEMPLATE_CODE=

# Optional single-process persistent share storage. Empty disables sharing.
# Example: TRAVEL_SHARES_DIR=.travel-shares
TRAVEL_SHARES_DIR=

# 同行协商空间（服务端账号、成员关系与持久化）
# 默认 logs/runtime/collaboration；测试或独立部署时可改为其他目录
COLLAB_DATA_DIR=

# 旅行聊天室身份签名。Node 与 Go 必须配置成同一个值，至少 16 字节；
# 留空时聊天服务退化为旧版无凭证模式，同行聊天入口会显示未配置。
CHAT_AUTH_SECRET=
# Node 调用 Go 管理接口的内部地址（默认 http://127.0.0.1:8080）
CHAT_INTERNAL_URL=
# Go 管理接口密钥，至少 16 字节；配置后移除成员会尝试立即断开其聊天连接。
# 留空时仅依赖聊天令牌 15 分钟过期，已移除成员的旧令牌在过期前仍可能可用。
CHAT_ADMIN_SECRET=
# Go 聊天服务本地聊天记录目录；留空则不落盘（仅内存缓存最近消息）
CHAT_HISTORY_DIR=
# Go WebSocket/历史接口的来源白名单，逗号分隔完整来源（scheme://host[:port]）；
# 留空时允许同源、localhost 与 127.0.0.1
CHAT_ALLOWED_ORIGINS=
