# 短信服务配置
# 复制此文件为 .env 并填写真实的API密钥

# 阿里云短信服务配置
VITE_SMS_API_KEY=your-aliyun-access-key-id
VITE_SMS_API_SECRET=your-aliyun-access-key-secret
VITE_SMS_SIGN_NAME=智游旅行
VITE_SMS_TEMPLATE_CODE=SMS_123456789

# 腾讯云短信服务配置（如果使用腾讯云）
# VITE_TENCENT_SMS_SECRET_ID=your-tencent-secret-id
# VITE_TENCENT_SMS_SECRET_KEY=your-tencent-secret-key
# VITE_TENCENT_SMS_APP_ID=your-tencent-app-id
# VITE_TENCENT_SMS_SIGN_NAME=智游旅行

# 云片短信服务配置（如果使用云片）
# VITE_YUNPIAN_API_KEY=your-yunpian-api-key