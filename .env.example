# 复制此文件为 .env。服务端变量不能使用 VITE_ 前缀。

# Node AI 服务（启动时读取项目根目录的 .env，系统环境变量优先）
PORT=3001
AI_API_KEY=
AI_API_ENDPOINT=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
AI_REQUEST_TIMEOUT_MS=30000

# 公开的前端接口配置；默认 /api 由开发服务器转发至 Node 服务
VITE_API_BASE_URL=/api
VITE_API_REQUEST_TIMEOUT_MS=10000
# 应大于服务端 AI_REQUEST_TIMEOUT_MS，为代理及响应传输留出时间
VITE_AI_REQUEST_TIMEOUT_MS=45000
# 仅在接入真实线路后端后填写；当前线路仍按账号保存在浏览器
VITE_ROUTES_API_BASE_URL=

# 可选的公开 WebSocket 地址；留空使用当前站点的 /ws（HTTPS 自动使用 wss）
VITE_CHAT_WS_URL=

# 高德 Web 端公开 Key；留空时显示地图未配置，不请求 SDK
VITE_AMAP_KEY=
# 可选的安全代理地址，以 /_AMapService 结尾；安全密钥只放在代理服务端
VITE_AMAP_SERVICE_HOST=

# 短信目前仍为演示实现。真实密钥只能配置在未来的服务端短信接口中。
# 以下为可公开的前端展示配置。
VITE_SMS_SIGN_NAME=智游旅行
VITE_SMS_TEMPLATE_CODE=SMS_123456789
