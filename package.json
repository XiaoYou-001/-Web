{
  "name": "my-vue-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/check-bundle.mjs",
    "check:bundle": "node scripts/check-bundle.mjs",
    "preview": "vite preview",
    "start:backend": "node server.js",
    "test:backend": "node --test tests/server.test.js",
    "test:chat": "node --test tests/chat-service.test.js tests/chat-views.test.js",
    "test:api": "node --test tests/api-client.test.js tests/customer-service.test.js tests/server.test.js",
    "test:map": "node --test tests/map-loader.test.js tests/attraction-map.test.js tests/ticket-lifecycle.test.js",
    "test:feedback": "node --test tests/feedback.test.js tests/form-feedback.test.js",
    "test:order": "node --test tests/order-lifecycle.test.js",
    "test:itinerary": "node --test tests/itinerary.test.js",
    "test:functional": "node --test tests/date.test.js tests/travel-views.test.js tests/auth.test.js tests/auth-views.test.js tests/user-data.test.js tests/persistence-views.test.js",
    "test": "node --test tests/*.test.js"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "@fortawesome/fontawesome-svg-core": "^6.7.2",
    "@fortawesome/free-solid-svg-icons": "^6.7.2",
    "@fortawesome/vue-fontawesome": "^3.0.8",
    "axios": "^1.12.2",
    "bootstrap-icons": "^1.13.1",
    "cors": "^2.8.5",
    "element-plus": "^2.10.4",
    "express": "^5.1.0",
    "markdown-it": "^15.0.3",
    "node-fetch": "^3.3.2",
    "openai": "^5.23.1",
    "pinia": "^3.0.3",
    "vue": "^3.5.17",
    "vue-datepicker-next": "^1.0.3",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.0",
    "nodemon": "^3.1.10",
    "vite": "^7.0.4"
  }
}
